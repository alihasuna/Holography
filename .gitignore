__pycache__/
*.py[cod]
.venv/
venv/
# a `venv` SYMLINK at the root (e.g. a git worktree pointing at the main checkout's venv, so
# that the Alliance-kit tests run there; `venv/` matches directories only)
/venv
*.h5
*.hdf5
*.npz
outputs/
.pytest_cache/
*.egg-info/

# SLURM job logs and dry-run text written by scripts/hpc/run_pipeline.slurm (copied into outputs/)
reflholo_*.log
reflholo_*_dryrun.txt

# Alliance kit setup logs (scripts/hpc/alliance/setup_alliance.sh; also copied into venv/alliance/)
alliance_setup_*.log

# run locks of tools/validation (report S5)
tools/validation/*.lock

# per-user Claude Code settings (for example the ~/.ssh deny rules of LOCAL_SESSION_PROMPT.md)
.claude/settings.local.json
