/content\/article\/PII:030439919390124G?httpAccept=text\/plain","content-type":"text\/plain","content-version":"vor","intended-application":"text-mining"}],"deposited":{"date-parts":[[2019,4,5]],"date-time":"2019-04-05T00:56:07Z","timestamp":1554425767000},"score":113.425964,"resource":{"primary":{"URL":"https:\/\/linkinghub.elsevier.com\/retrieve\/pii\/030439919390124G"}},"issued":{"date-parts":[[1993,4]]},"references-count":12,"journal-issue":{"issue":"4","published-print":{"date-parts":[[1993,4]]}},"alternative-id":["030439919390124G"],"URL":"https:\/\/doi.org\/10.1016\/0304-3991(93)90124-g","ISSN":["0304-3991"],"issn-type":[{"value":"0304-3991","type":"print"}],"published":{"date-parts":[[1993,4]]}},{"indexed":{"date-parts":[[2022,4,1]],"date-time":"2022-04-01T22:37:30Z","timestamp":1648852650065},"reference-count":5,"publisher":"Cambridge University Press (CUP)","license":[{"start":{"date-parts":[[2020,6,18]],"date-time":"2020-06-18T00:00:00Z","timestamp":1592438400000},"content-version":"unspecified","delay-in-days":11274,"URL":"https:\/\/www.cambridge.org\/core\/terms"}],"content-domain":{"domain":[],"crossmark-restriction":false},"short-container-title":["Proc. annu. meet. Electron Microsc. Soc. Am."],"published-print":{"date-parts":[[1989,8,6]]},"abstract":"<jats:p>Progress in microscopy such as STM and TEM-TED has revealed surface structures in atomic dimension. REM has been used for the observation of surface dynamical process and surface morphology. Recently developed reflection electron holography, which employes REM optics to measure the phase shift of reflected electron, has been proved to be effective for the observation of surface morphology in high vertical resolution \u2243 0.01 \u00c5.<\/jats:p><jats:p>The key to the high sensitivity of the method is best shown by comparing the phase shift generation by surface topography with that in transmission mode. Difference in refractive index between vacuum and material V<jats:sub>o<\/jats:sub>\/2E\u224310<jats:sup>-4<\/jats:sup> owes the phase shift in transmission mode as shownn Fig. 1( a). While geometrical path difference is created in reflection mode( Fig. 1(b) ), which is measured interferometrically using high energy electron beam of wavelength \u22430.01 \u00c5. Together with the phase amplification technique , the vertivcal resolution is expected to be \u22640.01 \u00c5 in an ideal case.<\/jats:p>","DOI":"10.1017\/s0424820100154652","type":"journal-article","created":{"date-parts":[[2020,6,18]],"date-time":"2020-06-18T11:12:59Z","timestamp":1592478779000},"page":"536-537","source":"Crossref","is-referenced-by-count":0,"title":["Observation of surface morphology by reflection electron holography"],"prefix":"10.1017","volume":"47","author":[{"given":"N.","family":"Osakabe","sequence":"first","affiliation":[],"role":[{"role":"author","vocabulary":"crossref"}]},{"given":"J.","family":"Endo","sequence":"additional","affiliation":[],"role":[{"role":"author","vocabulary":"crossref"}]},{"given":"T.","family":"Matsuda","sequence":"additional","affiliation":[],"role":[{"role":"author","vocabulary":"crossref"}]},{"given":"A.","family":"Tonomura","sequence":"additional","affiliation":[],"role":[{"role":"author","vocabulary":"crossref"}]}],"member":"56","published-online":{"date-parts":[[2020,6,18]]},"reference":[{"key":"S0424820100154652_ref02","doi-asserted-by":"publisher","DOI":"10.1016\/0039-6028(85)90753-8"},{"key":"S0424820100154652_ref01","doi-asserted-by":"publisher","DOI":"10.1103\/PhysRevLett.50.120"},{"key":"S0424820100154652_ref03","doi-asserted-by":"publisher","DOI":"10.1107\/S0021889887086916"},{"key":"S0424820100154652_ref04","doi-asserted-by":"publisher","DOI":"10.1143\/JJAP.27.L1772"},{"key":"S0424820100154652_ref05","doi-asserted-by":"publisher","DOI":"10.1103\/RevModPhys.59.639"}],"container-title":["Proceedings, annual meeting, Electron Microscopy Society of America"],"language":"en","link":[{"URL":"https:\/\/www.cambridge.org\/core\/services\/aop-ca