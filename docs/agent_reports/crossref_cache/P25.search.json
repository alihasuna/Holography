iction":false},"short-container-title":["Microscopy Res &amp; Technique"],"published-print":{"date-parts":[[1992,2,15]]},"abstract":"<jats:title>Abstract<\/jats:title><jats:p>Atomic steps on (111) and (100) crystal surfaces of Pt were observed using a commercial scanning electron microscope (SEM) in secondary electron mode. By comparing the SEM images and those by reflection electron microscopy (REM), the observed contrast was confirmed to be that from atomic steps on crystal surfaces. The contrast mechanism is briefly discussed. One application of this imaging technique is also shown.<\/jats:p>","DOI":"10.1002\/jemt.1070200410","type":"journal-article","created":{"date-parts":[[2005,2,23]],"date-time":"2005-02-23T17:50:56Z","timestamp":1109181056000},"page":"406-412","source":"Crossref","is-referenced-by-count":8,"title":["Observation of atomic steps on single crystal surfaces by a commercial scanning electron microscope"],"prefix":"10.1002","volume":"20","author":[{"given":"Yuji","family":"Uchida","sequence":"first","affiliation":[],"role":[{"role":"author","vocabulary":"crossref"}]},{"given":"Gisela","family":"Weinberg","sequence":"additional","affiliation":[],"role":[{"role":"author","vocabulary":"crossref"}]},{"given":"Gunter","family":"Lehmpfuhl","sequence":"additional","affiliation":[],"role":[{"role":"author","vocabulary":"crossref"}]}],"member":"311","published-online":{"date-parts":[[2005,2,4]]},"reference":[{"key":"e_1_2_1_2_1","doi-asserted-by":"publisher","DOI":"10.1016\/0304-3991(83)90004-9"},{"key":"e_1_2_1_3_1","first-page":"129","volume-title":"Proceedings of the XIth International Congress on Electron Microscopy","author":"Ichinokawa T.","year":"1986"},{"key":"e_1_2_1_4_1","first-page":"179","article-title":"Observation for crystal surface of W<100> field emitter tip by SEM","volume":"34","author":"Kuroda K.","year":"1985","journal-title":"J. Electron Microsc."},{"key":"e_1_2_1_5_1","doi-asserted-by":"publisher","DOI":"10.1016\/0039-6028(90)90805-I